# Copia questo file in .env e personalizza i valori prima di avviare i container:
#   cp .env.example .env

# --- Database -----------------------------------------------------------
DB_NAME=mailcadence
DB_USER=mailcadence_user
DB_PASSWORD=cambia_questa_password_forte
DB_ROOT_PASSWORD=cambia_anche_questa_root_password

# --- Applicazione ---------------------------------------------------------
# Stringa lunga e casuale usata per firmare i link di disiscrizione (HMAC). Generala con:
#   openssl rand -hex 32
APP_SECRET=cambia_con_una_stringa_lunga_e_casuale
SITE_URL=https://tuodominio.it

# Unico account amministratore dell'app. Puoi lasciare queste due righe vuote: al primo accesso
# l'app mostra una pagina di creazione account (/setup.php) che si disattiva da sola dopo l'uso.
# In alternativa, per impostarle a priori via .env, genera l'hash della password con:
#   php -r 'echo password_hash("la-tua-password", PASSWORD_DEFAULT), PHP_EOL;'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# --- SMTP (il tuo server proprio, non un servizio esterno) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM=
SMTP_FROM_NAME=MailCadence
